rules_version = '2';

// Deny by default. Every collection gets an explicit, tested rule when it is
// added; anything not matched below stays closed to clients. Cloud Functions
// use the Admin SDK, which is not subject to these rules.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
